# [TEMPLATE] - Copia este archivo como .env y completa los valores
# === Discord Configuration ===
DISCORD_TOKEN=tu_token_de_discord_aqui
CLIENT_ID=tu_client_id_de_discord_aqui

# === External APIs (multimedia downloads) ===
API_URL=https://api.stellarwa.xyz
API_KEY=tu_api_key_aqui
ALTERNATIVE_API_URL=https://api.siputzx.my.id

# === Owner Configuration ===
BOT_OWNER_ID=tu_id_de_discord_aqui  # Tu ID de usuario para comandos exclusivos (/reload)

# === Optional Configuration ===
LOG_LEVEL=INFO  # DEBUG | INFO | WARN | ERROR
PORT=3000

# === Lavalink / Spotify Configuration ===
# Obtén estas credenciales en: https://developer.spotify.com/dashboard
# ( crear app → Settings → Client ID / View client secret)
SPOTIFY_CLIENT_ID=tu_spotify_client_id_aqui
SPOTIFY_CLIENT_SECRET=tu_spotify_client_secret_aqui

# === AI Configuration (para funcionalidades de IA híbrida) ===
# Proveedores soportados: openai | groq | anthropic
AI_PROVIDER=openai
# OpenAI
OPENAI_API_KEY=tu_openai_api_key_aqui
OPENAI_MODEL=gpt-4o-mini
# Groq (alternativa)
GROQ_API_KEY=tu_groq_api_key_aqui
GROQ_MODEL=llama-3.1-8b-instant
# Anthropic (alternativa)
ANTHROPIC_API_KEY=tu_anthropic_api_key_aqui
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# Configuración general de IA
AI_MAX_TOKENS=500
AI_TIMEOUT_MS=10000
AI_RATE_LIMIT_PER_USER=10  # msgs por minuto
AI_RATE_LIMIT_WINDOW_MS=60000

# === Reminder Configuration ===
REMINDER_CHECK_INTERVAL_MS=60000  # Chequear recordatorios cada minuto
REMINDER_MAX_PER_USER=50